# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Stock video providers (at least one required) ---
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=
# Get a free key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# --- TikTok (Content Posting API, "upload to inbox" / draft flow) ---
# From your app at https://developers.tiktok.com/ (needs the video.upload scope).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Long-lived refresh token obtained once via scripts/get_refresh_token.py
TIKTOK_REFRESH_TOKEN=
# Must exactly match a redirect URI registered in your TikTok app.
# Used only by scripts/get_refresh_token.py during the one-time OAuth flow.
TIKTOK_REDIRECT_URI=http://localhost:8723/callback
