{
  "name": "school-app-primary",
  "version": "1.0.0",
  "description": "إيدوتراك — المدارس الابتدائية",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.edutrack.primary",
    "productName": "EduTrack Primary",
    "publish": {
      "provider": "github",
      "owner": "baker98baker-collab",
      "repo": "edutrack-primary-updates"
    },
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "installerIcon": "",
      "uninstallerIcon": "",
      "shortcutName": "إيدوتراك ابتدائي"
    }
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^9.0.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  }
}
